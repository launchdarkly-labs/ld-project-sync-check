{
  "name": "ld-project-sync-check",
  "version": "0.2.0",
  "description": "Compare two LaunchDarkly projects (e.g. US vs EU instance) field by field and report whether they are in sync.",
  "license": "Apache-2.0",
  "exports": "./lib/compare.js",
  "tasks": {
    "check": "deno run --allow-net --allow-env --allow-read --allow-write cli/main.js",
    "inventory": "deno run --allow-net --allow-env --allow-read --allow-write cli/inventory.js",
    "sdk-diff": "deno run --allow-net --allow-env --allow-read --allow-write cli/sdk_diff.js",
    "test": "deno test --allow-read test/",
    "lint": "deno lint lib/ cli/ web/ test/",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server --port 8000 ."
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/cli": "jsr:@std/cli@^1.0.6"
  },
  "lint": { "rules": { "tags": ["recommended"] } },
  "fmt": { "lineWidth": 100, "singleQuote": false }
}
